generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String           @default("")
  group       String
  recipes     RecipeCategory[]
  /// Member Topic follows (Roadmap #8). Category delete → Cascade.
  memberFollows UserCategoryFollow[]
  /// Optional primary context on followed-publish notifications.
  notificationContexts MemberNotification[]
}

model RecipeType {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String            @default("")
  fields      RecipeTypeField[]
  recipes     Recipe[]
}

model RecipeTypeField {
  id        String     @id @default(cuid())
  typeId    String
  type      RecipeType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  key       String
  label     String
  helpText  String     @default("")
  kind      String
  required  Boolean    @default(false)
  options   String     @default("[]")
  sortOrder Int        @default(0)

  @@unique([typeId, key])
}

model Recipe {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  excerpt     String           @default("")
  typeId      String
  type        RecipeType       @relation(fields: [typeId], references: [id])
  status      String           @default("draft")
  featured    Boolean          @default(false)
  seasonal    Boolean          @default(false)
  publishedAt DateTime?
  /// Optional reader-facing retest/improvement note (not Admin Revision History).
  publicUpdateNote String?
  /// Editorial date for the public update note (not Prisma @updatedAt).
  publicUpdatedAt DateTime?
  /// When set on a draft, cron publishes at/after this UTC instant if readiness allows.
  scheduledPublishAt DateTime?
  /// Optional ordered Recipe.id pins for “More from the studio” (JSON string array). Empty = automatic only.
  relatedRecipeIds String           @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  values      String           @default("{}")
  /// Non-public AI generation / editorial verification metadata (JSON).
  aiMeta      String           @default("{}")
  categories  RecipeCategory[]
  seriesItems SeriesItem[]
  studioLessonLinks StudioLessonRecipeLink[]
  saves       RecipeSave[]
  reviews     RecipeReview[]
  /// Private member Meal Planner items (Phase 5). Recipe delete → SetNull; denormalized slug/title kept.
  mealPlanItems MealPlanItem[]
  /// Derived ingredient-identity index (ING-2+). Authored text remains in values.ingredients.
  recipeIngredients RecipeIngredient[]
  /// Optional relation for live recipes only — see RecipeRevision.recipeId delete policy.
  revisions   RecipeRevision[]
  youtubeReleases YouTubeRelease[]
  /// Member in-app notifications (Roadmap #8). Recipe delete → SetNull (hide/unavailable at read).
  memberNotifications MemberNotification[]

  @@index([scheduledPublishAt, status])
  @@index([publishedAt])
}

/**
 * Canonical culinary ingredient identity (discovery/index vocabulary).
 *
 * Does NOT replace Recipe.values.ingredients authored display/amount/notes.
 * Empty after migration until ING-3 seed/backfill.
 */
model Ingredient {
  id        String   @id @default(cuid())
  /// Human-readable canonical name (e.g. "Egg", "Egg yolk").
  name      String
  /// ING-1 normalizeIngredientLookupKey(name) — unique identity key.
  nameNorm  String   @unique
  /// Stable public-safe id; not auto-renamed when name changes later.
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases           IngredientAlias[]
  recipeIngredients RecipeIngredient[]
}

/**
 * Known authored phrase mapping to one Ingredient.
 * aliasNorm is globally unique so matching stays deterministic.
 */
model IngredientAlias {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  /// Human alias phrase (e.g. "large eggs").
  alias        String
  /// ING-1 normalizeIngredientLookupKey(alias).
  aliasNorm    String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ingredientId])
}

/**
 * Derived Recipe.values.ingredients identity index.
 *
 * Authored source of truth remains Recipe.values.ingredients.
 * groupIndex/itemIndex locate the row; ING-3 rebuilds on save after reorder.
 * ingredientId is null when matchedVia = UNRESOLVED.
 */
model RecipeIngredient {
  id               String      @id @default(cuid())
  recipeId         String
  recipe           Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  /// Null when unmatched (matchedVia UNRESOLVED).
  ingredientId     String?
  ingredient       Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  groupIndex       Int
  itemIndex        Int
  /// Snapshot of authored item text at index time (diagnostics only).
  authoredItem     String      @default("")
  /// ING-1 normalizeIngredientLookupKey(authoredItem).
  authoredItemNorm String      @default("")
  /// EXACT | ALIAS | UNRESOLVED
  matchedVia       String      @default("UNRESOLVED")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([recipeId, groupIndex, itemIndex])
  @@index([recipeId])
  @@index([ingredientId])
  @@index([ingredientId, recipeId])
  @@index([matchedVia, authoredItemNorm])
}

model AiRecipeGenerationCache {
  id            String   @id @default(cuid())
  videoId       String
  typeId        String
  schemaVersion String
  model         String
  responseJson  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([videoId, typeId, schemaVersion])
  @@index([videoId])
}

model RecipeCategory {
  recipeId   String
  categoryId String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
}

/**
 * Recoverable recipe content snapshots (not Admin Audit).
 *
 * Delete policy: recipeId uses onDelete SetNull so permanent recipe deletion does
 * not erase recovery history. `stableRecipeId` always retains Recipe.id for lookup.
 * Slug/status in the snapshot are historical context only — restore preserves current
 * public URL and publication state.
 */
model RecipeRevision {
  id                     String   @id @default(cuid())
  createdAt              DateTime @default(now())
  /// Live FK while the recipe exists; null after recipe hard-delete.
  recipeId               String?
  recipe                 Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// Immutable Recipe.id at revision time — survives recipe deletion.
  stableRecipeId         String
  adminId                String?
  admin                  Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorName              String   @default("")
  actorRole              String   @default("")
  /// created | saved | published | moved_to_draft | restored | baseline
  reason                 String   @default("saved")
  /// Canonical JSON from buildRecipeRevisionSnapshot.
  snapshot               String   @default("{}")
  /// Hash of recoverable content only (excludes slug/status/publishedAt).
  contentHash            String   @default("")
  /// Coarse section names JSON array, e.g. ["ingredients","instructions"].
  changedFields          String   @default("[]")
  restoredFromRevisionId String?
  note                   String   @default("")

  @@index([recipeId, createdAt])
  @@index([stableRecipeId, createdAt])
  @@index([contentHash])
  @@index([adminId, createdAt])
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String?
  photoUrl     String           @default("")
  notify       Boolean          @default(false)
  sessionVersion Int            @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lastSeenAt   DateTime         @default(now())
  saves        RecipeSave[]
  savedRecipeCollections SavedRecipeCollection[]
  mealPlans    MealPlan[]
  connections  UserConnection[]
  reviews      RecipeReview[]
  presenceSessions MemberPresenceSession[]
  /// Roadmap #8 — Follow Series / Topics + in-app notifications (Cascade on User delete).
  seriesFollows UserSeriesFollow[]
  categoryFollows UserCategoryFollow[]
  memberNotifications MemberNotification[]
}

/** Per-browser/device heartbeat rows for session-aware Online status. */
model MemberPresenceSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, sessionKey])
  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
}

model RecipeSave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable recipe identity. Nullable until legacy rows are backfilled / orphaned.
  recipeId  String?
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// Legacy / denormalized public URL slug (kept for display + migration safety).
  slug      String
  /// Denormalized title for profile lists when recipe is missing.
  title     String
  createdAt DateTime @default(now())
  /// Private member collection memberships (Phase 4). Cascade when RecipeSave is removed.
  collectionItems SavedRecipeCollectionItem[]

  @@unique([userId, slug])
  @@unique([userId, recipeId])
  @@index([recipeId])
}

/**
 * Private member organization of RecipeSave rows.
 * Distinct from public editorial Collections (Series / SeriesItem).
 * "All Saved" is virtual — never stored as a row.
 */
model SavedRecipeCollection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Lowercased trimmed name for per-member uniqueness.
  nameNorm  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     SavedRecipeCollectionItem[]

  @@unique([userId, nameNorm])
  @@index([userId, updatedAt])
}

/** Membership: organizes an existing RecipeSave; never duplicates save state. */
model SavedRecipeCollectionItem {
  id           String                @id @default(cuid())
  collectionId String
  collection   SavedRecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipeSaveId String
  recipeSave   RecipeSave            @relation(fields: [recipeSaveId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())

  @@unique([collectionId, recipeSaveId])
  @@index([recipeSaveId])
  @@index([collectionId, createdAt])
}

/**
 * Private member Meal Planner plan (Phase 5).
 * Not public; no slug/sharing. Distinct from SavedRecipeCollection.
 */
model MealPlan {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Lowercased trimmed name for per-member uniqueness (same philosophy as SavedRecipeCollection).
  nameNorm  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     MealPlanItem[]

  @@unique([userId, nameNorm])
  @@index([userId, updatedAt])
}

/**
 * Recipe-based Meal Plan row. recipeId may become null when Recipe is deleted;
 * recipeSlug / recipeTitle remain for orphan-safe display. Same recipe may appear more than once.
 */
model MealPlanItem {
  id              String    @id @default(cuid())
  planId          String
  plan            MealPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipeId        String?
  recipe          Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// Denormalized public URL slug (orphan-safe).
  recipeSlug      String
  /// Denormalized display title (orphan-safe).
  recipeTitle     String
  /// Member-local civil calendar date YYYY-MM-DD (not DateTime / not Admin TRT).
  planDate        String
  /// MVP slots only: breakfast | lunch | dinner | snack
  mealSlot        String
  sortOrder       Int
  plannedServings Int
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([planId, planDate, mealSlot, sortOrder])
  @@index([recipeId])
  @@index([planId, recipeId])
}

model RecipeReview {
  id          String              @id @default(cuid())
  /// Stable recipe identity. Nullable until legacy rows are backfilled / orphaned.
  recipeId    String?
  recipe      Recipe?             @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// Legacy / denormalized slug at write time (kept for migration + Admin fallback).
  recipeSlug  String
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String
  rating      Int
  body        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  replies     RecipeReviewReply[]

  @@unique([recipeSlug, authorEmail])
  @@index([recipeSlug, createdAt])
  @@index([recipeId])
  @@index([recipeId, createdAt])
  /// Canonical unique(recipeId, authorEmail) deferred until production conflicts are cleared
  /// (see backfillRecipeIdentity reviewConflictDetails). App writes already key by recipeId.
}

model RecipeReviewReply {
  id             String       @id @default(cuid())
  reviewId       String
  review         RecipeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorName     String
  authorTitle    String       @default("")
  authorEmail    String
  authorPhotoUrl String       @default("")
  body           String
  isStaff        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([reviewId, createdAt])
}

model UserConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  method    String
  ip        String
  country   String   @default("")
  city      String   @default("")
  region    String   @default("")
  userAgent String   @default("")
  referer   String   @default("")
  createdAt DateTime @default(now())
}

model Admin {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  passwordHash   String
  role           String
  photoUrl       String         @default("")
  /** Bumped on password change to revoke existing mesa_admin_session cookies. */
  sessionVersion Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lastSeenAt     DateTime       @default(now())
  sessions       AdminSession[]
  auditEvents    AdminAuditEvent[]
  recipeRevisions RecipeRevision[]
  mediaAssets    MediaAsset[]
  notifications  AdminNotification[]
  notificationReceipts AdminNotificationReceipt[]
}

/**
 * Server-side registry for Studio admin cookie sessions (`mesa_admin_session`).
 * Opaque `sessionTokenId` is embedded in the signed cookie as `sid`.
 * System Owner (env) rows use subjectKey "env" with adminId null.
 */
model AdminSession {
  id              String    @id @default(cuid())
  adminId         String?
  /** Opaque id placed in the admin cookie — never the database row id alone for auth. */
  sessionTokenId  String    @unique
  /** adminId for named staff, or "env" for System Owner. */
  subjectKey      String
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String    @default("")
  userAgent       String    @default("")
  browser         String    @default("")
  browserVersion  String    @default("")
  operatingSystem String    @default("")
  deviceType      String    @default("")
  ipAddress       String?
  country         String    @default("")
  region          String    @default("")
  city            String    @default("")
  admin           Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([subjectKey])
  @@index([sessionTokenId])
  @@index([lastSeenAt])
  @@index([revokedAt])
  @@index([expiresAt])
  @@index([subjectKey, revokedAt, expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  kind      String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model GuestVisitor {
  id          String         @id @default(cuid())
  visitorKey  String         @unique
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  lastPath    String         @default("")
  /** Raw network IP; scrubbed to null after GUEST_NETWORK_RETENTION_DAYS. */
  ip          String?
  /** When `ip` was last written on ingest; used for accurate network retention age. */
  ipUpdatedAt DateTime?
  country     String         @default("")
  city        String         @default("")
  region      String         @default("")
  userAgent   String         @default("")
  /** First-touch campaign attribution (never overwritten once set). */
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /** Phase 2D audience class: human | likely_automated | bot | unknown */
  clientKind         String?
  /** JSON array of reason codes (explainable, no opaque scores). */
  clientKindReasons  String?
  clientKindAt       DateTime?
  pageViews   GuestPageView[]
  presenceSessions GuestPresenceSession[]
  funnelEvents FunnelEvent[]
  searchEvents SearchEvent[]

  @@index([lastSeenAt])
  @@index([ipUpdatedAt])
}

/** Per-tab anonymous heartbeat rows for session-aware Online status. */
model GuestPresenceSession {
  id            String       @id @default(cuid())
  visitorId     String
  visitor       GuestVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  connectionKey String
  lastSeenAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@unique([visitorId, connectionKey])
  @@index([lastSeenAt])
  @@index([visitorId, lastSeenAt])
}

model GuestPageView {
  id        String       @id @default(cuid())
  visitorId String
  visitor   GuestVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  /** Client navigation event id; null on legacy rows. Dedupes Strict Mode / retries. */
  navId     String?      @unique
  path      String
  referer   String       @default("")
  /** Raw page-view IP snapshot; scrubbed to null after GUEST_NETWORK_RETENTION_DAYS. */
  ip        String?
  country   String       @default("")
  city      String       @default("")
  region    String       @default("")
  userAgent String       @default("")
  createdAt DateTime     @default(now())

  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@index([path])
}

/** Website → YouTube funnel interaction events (anonymous guest visitor). */
model FunnelEvent {
  id                 String       @id @default(cuid())
  visitorId          String
  visitor            GuestVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  name               String
  recipeId           String       @default("")
  recipeSlug         String       @default("")
  youtubeVideoId     String       @default("")
  targetRecipeId     String       @default("")
  targetVideoId      String       @default("")
  placement          String       @default("")
  chapterLabel       String       @default("")
  chapterTimeSeconds Int?
  chapterIndex       Int?
  /// Opaque JSON props bag (no PII).
  meta               String       @default("{}")
  createdAt          DateTime     @default(now())

  @@index([createdAt, name])
  @@index([recipeSlug, createdAt])
  @@index([youtubeVideoId, createdAt])
  @@index([visitorId, createdAt])
  @@index([name, visitorId, recipeSlug, createdAt])
}

/**
 * First-party recipe search / discovery intelligence (consent-gated).
 * Aggregated for popular + zero-result terms — not a per-user profile.
 */
model SearchEvent {
  id          String       @id @default(cuid())
  visitorId   String
  visitor     GuestVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  /// Normalized query for aggregation (lowercase, collapsed whitespace).
  queryNorm   String       @default("")
  /// Trimmed original query for admin display (clipped).
  queryRaw    String       @default("")
  resultCount Int          @default(0)
  zeroResult  Boolean      @default(false)
  /// search_overlay | recipes_catalog
  placement   String       @default("")
  /// Optional discovery filter context JSON (no PII).
  filters     String       @default("{}")
  createdAt   DateTime     @default(now())

  @@index([createdAt])
  @@index([queryNorm, createdAt])
  @@index([zeroResult, createdAt])
  @@index([visitorId, createdAt])
}

model NewsletterSubscriber {
  id                   String    @id @default(cuid())
  email                String    @unique
  source               String    @default("site")
  /** active | unsubscribed */
  status               String    @default("active")
  /** SHA-256 hex of the raw unsubscribe token (raw token never stored). */
  unsubscribeTokenHash String?   @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt
  unsubscribedAt       DateTime?

  @@index([createdAt])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Cached Mesa Kitchen Studio YouTube channel metadata (Data API v3).
model YouTubeChannel {
  id                   String   @id @default(cuid())
  channelId            String   @unique
  title                String   @default("")
  description          String   @default("")
  customUrl            String   @default("")
  publishedAt          DateTime?
  thumbnailUrl         String   @default("")
  country              String   @default("")
  uploadsPlaylistId    String   @default("")
  viewCount            String   @default("0")
  subscriberCount      String   @default("0")
  hiddenSubscriberCount Boolean @default(false)
  videoCount           String   @default("0")
  lastSyncedAt         DateTime?
  lastSyncAttemptAt    DateTime?
  lastSyncError        String   @default("")
  lastSyncStatus       String   @default("never")
  snapshots            YouTubeChannelSnapshot[]
  videos               YouTubeVideo[]
}

/// Uploaded video metadata synced from YouTube Data API v3 (public + OAuth private/scheduled).
model YouTubeVideo {
  id              String   @id @default(cuid())
  videoId         String   @unique
  channelId       String
  channel         YouTubeChannel @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  title           String   @default("")
  description     String   @default("")
  publishedAt     DateTime?
  /** YouTube status.publishAt — future time when a private upload is scheduled to go public. */
  scheduledPublishAt DateTime?
  thumbnailUrl    String   @default("")
  durationSeconds Int      @default(0)
  durationDisplay String   @default("")
  tags            String   @default("[]")
  categoryId      String   @default("")
  definition      String   @default("")
  caption         String   @default("")
  privacyStatus   String   @default("")
  /** YouTube status.uploadStatus (uploaded, processed, rejected, …). */
  uploadStatus    String   @default("")
  embeddable      Boolean  @default(true)
  madeForKids     Boolean  @default(false)
  viewCount       String   @default("0")
  likeCount       String   @default("0")
  commentCount    String   @default("0")
  lastSyncedAt    DateTime?
  snapshots       YouTubeVideoSnapshot[]
  seriesItems     SeriesItem[]
  releases        YouTubeRelease[]

  @@index([channelId, publishedAt])
  @@index([scheduledPublishAt])
}

/// Local publishing planner row (backlog / planned / skipped / linked). Open cadence slots are projected in memory, not stored.
model YouTubeRelease {
  id             String    @id @default(cuid())
  /// BACKLOG | PLANNED | SCHEDULED | PUBLISHED | SKIPPED
  status         String
  workingTitle   String    @default("")
  /// LONG | SHORT | SPECIAL
  videoType      String    @default("LONG")
  releaseAt      DateTime?
  timezone       String    @default("Europe/Istanbul")
  youtubeVideoId String?
  youtubeVideo   YouTubeVideo? @relation(fields: [youtubeVideoId], references: [videoId], onDelete: SetNull)
  /// Optional stable Recipe link for planning before/without a synced YouTubeVideo.
  recipeId       String?
  recipe         Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  notes          String    @default("")
  skipReason     String    @default("")
  /// Stable Istanbul date key for skipped/assigned cadence slots (e.g. "2026-09-25").
  slotKey        String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([releaseAt])
  @@index([status])
  @@index([youtubeVideoId])
  @@index([recipeId])
  @@index([slotKey])
}

/// Mesa cooking series — custom collections or imported YouTube playlists.
model Series {
  id                          String       @id @default(cuid())
  slug                        String       @unique
  title                       String
  shortTitle                  String       @default("")
  description                 String       @default("")
  intro                       String       @default("")
  heroImage                   String       @default("")
  seoTitle                    String       @default("")
  seoDescription              String       @default("")
  /// YOUTUBE = imported playlist; CUSTOM = Mesa-only collection.
  syncMode                    String       @default("CUSTOM")
  /// When true (typical for YOUTUBE mode), refresh reorders items to match playlist.
  followYoutubeOrder          Boolean      @default(true)
  youtubePlaylistId           String       @default("")
  youtubePlaylistTitle        String       @default("")
  youtubePlaylistDescription  String       @default("")
  youtubePlaylistThumbnail    String       @default("")
  youtubePlaylistLastSyncedAt DateTime?
  /// AI editorial provenance + generation metadata (JSON).
  aiMeta                      String       @default("{}")
  /// "" | auto_* | manual — manual heroes are never overwritten by AI/refresh.
  heroImageSource             String       @default("")
  isPublished                 Boolean      @default(false)
  sortOrder                   Int          @default(0)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  items                       SeriesItem[]
  /// Member Series follows (Roadmap #8). Series delete → Cascade.
  memberFollows UserSeriesFollow[]
  /// Optional primary context on followed-publish notifications.
  notificationContexts MemberNotification[]

  @@index([isPublished, sortOrder])
  @@index([youtubePlaylistId])
}

/**
 * Member follows a published Series (public “Collection”).
 * Trusted persistence only — public actions derive userId from session (Phase 8C).
 */
model UserSeriesFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, seriesId])
  @@index([seriesId])
  @@index([userId, createdAt])
}

/**
 * Member follows an eligible public Category (“Topic”).
 * Domain allow-list: course | desserts | holiday (not method).
 */
model UserCategoryFollow {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
  @@index([categoryId])
  @@index([userId, createdAt])
}

/**
 * Persistent in-app member notification (Roadmap #8).
 * MVP type: RECIPE_FOLLOWED_PUBLISH. Dedupe: one per member per Recipe ever.
 */
model MemberNotification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// RECIPE_FOLLOWED_PUBLISH (string for SQLite/Postgres parity; no speculative enum sprawl).
  type       String
  recipeId   String?
  recipe     Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  /// Canonical key e.g. recipe.followed_publish:{recipeId} — unique per user.
  dedupeKey  String
  /// At most one primary context (series XOR category) — enforced in domain layer.
  seriesId   String?
  series     Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([recipeId])
}

/// Ordered content row inside a Series (recipe and/or synced YouTube video).
model SeriesItem {
  id                  String        @id @default(cuid())
  seriesId            String
  series              Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  recipeId            String?
  recipe              Recipe?       @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  youtubeVideoId      String?
  youtubeVideo        YouTubeVideo? @relation(fields: [youtubeVideoId], references: [videoId], onDelete: SetNull)
  sortOrder           Int           @default(0)
  customTitle         String        @default("")
  customDescription   String        @default("")
  featured            Boolean       @default(false)
  /// Still kept in Mesa Series but no longer present on the YouTube playlist.
  removedFromPlaylist Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([seriesId, sortOrder])
  @@index([recipeId])
  @@index([youtubeVideoId])
}

/// Periodic public counter snapshot for channel trend deltas.
model YouTubeChannelSnapshot {
  id               String         @id @default(cuid())
  channelId        String
  channel          YouTubeChannel @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  recordedAt       DateTime       @default(now())
  viewCount        String         @default("0")
  subscriberCount  String         @default("0")
  videoCount       String         @default("0")

  @@index([channelId, recordedAt])
}

/// Periodic public counter snapshot for video trend deltas.
model YouTubeVideoSnapshot {
  id           String       @id @default(cuid())
  videoId      String
  video        YouTubeVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  recordedAt   DateTime     @default(now())
  viewCount    String       @default("0")
  likeCount    String       @default("0")
  commentCount String       @default("0")

  @@index([videoId, recordedAt])
}

/// Owner OAuth connection for YouTube Analytics API (not NextAuth login).
model YouTubeAnalyticsConnection {
  id                 String   @id @default(cuid())
  channelId          String   @default("")
  channelTitle       String   @default("")
  googleAccountEmail String   @default("")
  /// AES-256-GCM sealed refresh token (base64 ciphertext).
  refreshTokenEnc    String   @default("")
  tokenIv            String   @default("")
  tokenAuthTag       String   @default("")
  scopes             String   @default("")
  status             String   @default("disconnected")
  connectedAt        DateTime?
  connectedByAdminId String   @default("")
  lastRefreshAt      DateTime?
  lastSyncAt         DateTime?
  lastError          String   @default("")
  /// SUCCESS_WITH_DATA | SUCCESS_NO_DATA | API_ERROR (per-video Top videos sync).
  videoMetricsStatus String   @default("")
  videoMetricsError  String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Daily channel metrics from YouTube Analytics API.
model YouTubeAnalyticsChannelDay {
  id                       String   @id @default(cuid())
  channelId                String
  date                     DateTime
  views                    Int      @default(0)
  estimatedMinutesWatched  Int      @default(0)
  averageViewDuration      Float    @default(0)
  averageViewPercentage    Float    @default(0)
  subscribersGained        Int      @default(0)
  subscribersLost          Int      @default(0)
  likes                    Int      @default(0)
  comments                 Int      @default(0)
  shares                   Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([channelId, date])
  @@index([channelId, date])
}

/// Daily per-video metrics from YouTube Analytics API.
model YouTubeAnalyticsVideoDay {
  id                       String   @id @default(cuid())
  videoId                  String
  channelId                String   @default("")
  date                     DateTime
  views                    Int      @default(0)
  estimatedMinutesWatched  Int      @default(0)
  averageViewDuration      Float    @default(0)
  averageViewPercentage    Float    @default(0)
  subscribersGained        Int      @default(0)
  subscribersLost          Int      @default(0)
  likes                    Int      @default(0)
  comments                 Int      @default(0)
  shares                   Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([videoId, date])
  @@index([videoId, date])
  @@index([channelId, date])
}

/// Traffic-source / playback-location foundation (Phase 1 storage; UI later).
model YouTubeAnalyticsTrafficDay {
  id                       String   @id @default(cuid())
  scope                    String
  channelId                String   @default("")
  videoId                  String   @default("")
  date                     DateTime
  dimension                String
  dimensionValue           String   @default("")
  views                    Int      @default(0)
  estimatedMinutesWatched  Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([scope, channelId, videoId, date, dimension, dimensionValue])
  @@index([channelId, date, dimension])
  @@index([videoId, date, dimension])
}

/** Permanent URL redirects (e.g. published recipe slug changes). */
model Redirect {
  id         String   @id @default(cuid())
  /** Normalized public pathname, e.g. "/recipes/classic-baguettes". */
  fromPath   String   @unique
  /** Destination pathname (usually another public recipe path). */
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  /** recipe_slug_change | manual */
  source     String   @default("manual")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, fromPath])
  @@index([toPath])
}

/**
 * Global Admin operational audit log (not recipe revision history).
 * Survives Admin account deletion via SetNull on adminId.
 */
model AdminAuditEvent {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  /// FK when actor is a Team Access Admin row; null for System Owner ("env") or system.
  adminId      String?
  admin        Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorType    String   @default("admin")
  actorName    String   @default("")
  actorEmail   String   @default("")
  actorRole    String   @default("")
  /// Machine-readable action, e.g. recipe.published
  action       String
  /// Aligns with AdminArea where practical: content | members | staff | youtube
  area         String   @default("content")
  entityType   String   @default("")
  entityId     String   @default("")
  entityLabel  String   @default("")
  entityPath   String   @default("")
  /// Curated JSON summary — never passwords/tokens/full recipe.values.
  metadata     String   @default("{}")

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([area, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([adminId, createdAt])
  @@index([actorEmail, createdAt])
}

/**
 * Staff inbox (Phase 6C). Not AdminAuditEvent — operational alerts editors act on.
 * Viewing does not create audit noise.
 *
 * Read/dismiss state is per Admin via AdminNotificationReceipt — never shared
 * globally on this row.
 */
model AdminNotification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Machine type, e.g. recipe.schedule.succeeded
  type      String
  title     String
  body      String   @default("")
  /// info | success | attention
  severity  String   @default("info")

  entityType  String @default("")
  entityId    String @default("")
  entityLabel String @default("")
  entityPath  String @default("")

  /// null = visible to all content-capable staff
  recipientAdminId String?
  recipientAdmin   Admin?  @relation(fields: [recipientAdminId], references: [id], onDelete: SetNull)

  /// Curated JSON — never secrets or full recipe.values
  metadata String @default("{}")

  receipts AdminNotificationReceipt[]

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([recipientAdminId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([type, entityId, createdAt])
}

/**
 * Per-Admin read/dismiss state for a shared AdminNotification.
 * adminKey is Admin.id or "env" for System Owner.
 */
model AdminNotificationReceipt {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  notificationId String
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  adminKey       String
  adminId        String?
  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  readAt         DateTime?
  dismissedAt    DateTime?

  @@unique([notificationId, adminKey])
  @@index([adminKey, dismissedAt, readAt, createdAt])
  @@index([adminId, createdAt])
}

/**
 * Editorial media catalogue (Phase 6B).
 *
 * Storage (Blob / local uploads) owns bytes. MediaAsset owns identity, metadata,
 * reuse, and Admin library management. Recipe.values.image remains the public
 * delivery URL; optional values.heroMediaAssetId links back to this row.
 */
model MediaAsset {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Public delivery URL (owned upload or registered external).
  url       String
  /// Editorial browse title (not a Recipe title).
  title     String   @default("")
  /// Default alt text editors may reuse on attach.
  altText   String   @default("")
  credit    String   @default("")
  notes     String   @default("")

  mimeType  String   @default("")
  byteSize  Int?

  /// upload | external_url | youtube_thumbnail | imported
  source    String   @default("upload")
  /// image | recipe_hero | series_hero | general
  kind      String   @default("image")
  /// Soft-retire from pickers without deleting storage bytes.
  isActive  Boolean  @default(true)

  createdByAdminId String?
  createdByAdmin   Admin?  @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([url])
  @@index([isActive, updatedAt])
  @@index([kind, isActive])
  @@index([createdByAdminId])
}

/** Key-value site settings (e.g. homepage featured recipe slug). */
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model StudioLessonRecipeLink {
  lessonSlug String
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@id([lessonSlug, recipeId])
  @@index([lessonSlug, sortOrder])
  @@index([recipeId])
}

/**
 * Owner OAuth connection for Google Search Console (Phase 7A).
 * Separate from YouTubeAnalyticsConnection — different scopes and sync domain.
 * Historical page/query metrics are retained across disconnect.
 */
model SearchConsoleConnection {
  id                 String   @id @default(cuid())
  googleAccountEmail String   @default("")
  /// AES-256-GCM sealed refresh token (base64 ciphertext). Keyed mesa-gsc:.
  refreshTokenEnc    String   @default("")
  tokenIv            String   @default("")
  tokenAuthTag       String   @default("")
  scopes             String   @default("")
  status             String   @default("disconnected")
  /// Exact Search Console siteUrl / property identifier from Google.
  selectedProperty   String   @default("")
  /// DOMAIN | URL_PREFIX | "" when unset
  selectedPropertyType String @default("")
  connectedAt        DateTime?
  connectedByAdminId String   @default("")
  lastRefreshAt      DateTime?
  lastSyncStartedAt  DateTime?
  lastSyncCompletedAt DateTime?
  lastSuccessfulSyncAt DateTime?
  /// Latest calendar date (UTC midnight) present in synced metrics.
  lastDataDate       DateTime?
  lastErrorCode      String   @default("")
  lastErrorMessage   String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pageMetrics  SearchConsolePageMetric[]
  queryMetrics SearchConsoleQueryMetric[]
}

/// Daily page performance from Search Console Search Analytics.
model SearchConsolePageMetric {
  id           String   @id @default(cuid())
  connectionId String
  connection   SearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Google reporting calendar date (UTC midnight).
  date         DateTime
  /// Original page URL as reported by Search Console (historical truth).
  pageUrl      String
  /// Mesa pathname helper when URL matches canonical hosts; else "".
  normalizedPath String @default("")
  clicks       Float    @default(0)
  impressions  Float    @default(0)
  /// Click-through ratio (0–1), not percentage text.
  ctr          Float    @default(0)
  /// Average position for this page/date.
  position     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([connectionId, date, pageUrl])
  @@index([connectionId, date])
  @@index([connectionId, pageUrl, date])
  @@index([connectionId, normalizedPath, date])
}

/// Daily site-level Google search query performance (not Mesa SearchEvent).
model SearchConsoleQueryMetric {
  id           String   @id @default(cuid())
  connectionId String
  connection   SearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  date         DateTime
  query        String
  clicks       Float    @default(0)
  impressions  Float    @default(0)
  ctr          Float    @default(0)
  position     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([connectionId, date, query])
  @@index([connectionId, date])
  @@index([connectionId, query, date])
}
