generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String           @default("")
  group       String
  recipes     RecipeCategory[]
}

model RecipeType {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String            @default("")
  fields      RecipeTypeField[]
  recipes     Recipe[]
}

model RecipeTypeField {
  id        String     @id @default(cuid())
  typeId    String
  type      RecipeType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  key       String
  label     String
  helpText  String     @default("")
  kind      String
  required  Boolean    @default(false)
  options   String     @default("[]")
  sortOrder Int        @default(0)

  @@unique([typeId, key])
}

model Recipe {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  excerpt     String           @default("")
  typeId      String
  type        RecipeType       @relation(fields: [typeId], references: [id])
  status      String           @default("draft")
  featured    Boolean          @default(false)
  seasonal    Boolean          @default(false)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  values      String           @default("{}")
  categories  RecipeCategory[]
}

model RecipeCategory {
  recipeId   String
  categoryId String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String?
  notify       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lastSeenAt   DateTime         @default(now())
  saves        RecipeSave[]
  connections  UserConnection[]
  reviews      RecipeReview[]
}

model RecipeSave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  createdAt DateTime @default(now())

  @@unique([userId, slug])
}

model RecipeReview {
  id          String              @id @default(cuid())
  recipeSlug  String
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String
  rating      Int
  body        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  replies     RecipeReviewReply[]

  @@unique([recipeSlug, authorEmail])
  @@index([recipeSlug, createdAt])
}

model RecipeReviewReply {
  id          String       @id @default(cuid())
  reviewId    String
  review      RecipeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorName  String
  authorTitle String       @default("")
  authorEmail String
  body        String
  isStaff     Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([reviewId, createdAt])
}

model UserConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  method    String
  ip        String
  country   String   @default("")
  city      String   @default("")
  region    String   @default("")
  userAgent String   @default("")
  referer   String   @default("")
  createdAt DateTime @default(now())
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSeenAt   DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  kind      String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
