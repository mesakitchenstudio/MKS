generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String           @default("")
  group       String
  recipes     RecipeCategory[]
}

model RecipeType {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String            @default("")
  fields      RecipeTypeField[]
  recipes     Recipe[]
}

model RecipeTypeField {
  id        String     @id @default(cuid())
  typeId    String
  type      RecipeType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  key       String
  label     String
  helpText  String     @default("")
  kind      String
  required  Boolean    @default(false)
  options   String     @default("[]")
  sortOrder Int        @default(0)

  @@unique([typeId, key])
}

model Recipe {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  excerpt     String           @default("")
  typeId      String
  type        RecipeType       @relation(fields: [typeId], references: [id])
  status      String           @default("draft")
  featured    Boolean          @default(false)
  seasonal    Boolean          @default(false)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  values      String           @default("{}")
  /// Non-public AI generation / editorial verification metadata (JSON).
  aiMeta      String           @default("{}")
  categories  RecipeCategory[]
}

model AiRecipeGenerationCache {
  id            String   @id @default(cuid())
  videoId       String
  typeId        String
  schemaVersion String
  model         String
  responseJson  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([videoId, typeId, schemaVersion])
  @@index([videoId])
}

model RecipeCategory {
  recipeId   String
  categoryId String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String?
  photoUrl     String           @default("")
  notify       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lastSeenAt   DateTime         @default(now())
  saves        RecipeSave[]
  connections  UserConnection[]
  reviews      RecipeReview[]
  presenceSessions MemberPresenceSession[]
}

/** Per-browser/device heartbeat rows for session-aware Online status. */
model MemberPresenceSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionKey String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, sessionKey])
  @@index([lastSeenAt])
  @@index([userId, lastSeenAt])
}

model RecipeSave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  createdAt DateTime @default(now())

  @@unique([userId, slug])
}

model RecipeReview {
  id          String              @id @default(cuid())
  recipeSlug  String
  userId      String?
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String
  rating      Int
  body        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  replies     RecipeReviewReply[]

  @@unique([recipeSlug, authorEmail])
  @@index([recipeSlug, createdAt])
}

model RecipeReviewReply {
  id             String       @id @default(cuid())
  reviewId       String
  review         RecipeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorName     String
  authorTitle    String       @default("")
  authorEmail    String
  authorPhotoUrl String       @default("")
  body           String
  isStaff        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([reviewId, createdAt])
}

model UserConnection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  method    String
  ip        String
  country   String   @default("")
  city      String   @default("")
  region    String   @default("")
  userAgent String   @default("")
  referer   String   @default("")
  createdAt DateTime @default(now())
}

model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String
  photoUrl       String   @default("")
  /** Bumped on password change to revoke existing mesa_admin_session cookies. */
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastSeenAt     DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  kind      String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model GuestVisitor {
  id          String         @id @default(cuid())
  visitorKey  String         @unique
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  lastPath    String         @default("")
  ip          String         @default("")
  country     String         @default("")
  city        String         @default("")
  region      String         @default("")
  userAgent   String         @default("")
  pageViews   GuestPageView[]
  presenceSessions GuestPresenceSession[]
}

/** Per-tab anonymous heartbeat rows for session-aware Online status. */
model GuestPresenceSession {
  id            String       @id @default(cuid())
  visitorId     String
  visitor       GuestVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  connectionKey String
  lastSeenAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@unique([visitorId, connectionKey])
  @@index([lastSeenAt])
  @@index([visitorId, lastSeenAt])
}

model GuestPageView {
  id        String       @id @default(cuid())
  visitorId String
  visitor   GuestVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  /** Client navigation event id; null on legacy rows. Dedupes Strict Mode / retries. */
  navId     String?      @unique
  path      String
  referer   String       @default("")
  ip        String       @default("")
  country   String       @default("")
  city      String       @default("")
  region    String       @default("")
  userAgent String       @default("")
  createdAt DateTime     @default(now())

  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@index([path])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("site")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Cached Mesa Kitchen Studio YouTube channel metadata (Data API v3).
model YouTubeChannel {
  id                   String   @id @default(cuid())
  channelId            String   @unique
  title                String   @default("")
  description          String   @default("")
  customUrl            String   @default("")
  publishedAt          DateTime?
  thumbnailUrl         String   @default("")
  country              String   @default("")
  uploadsPlaylistId    String   @default("")
  viewCount            String   @default("0")
  subscriberCount      String   @default("0")
  hiddenSubscriberCount Boolean @default(false)
  videoCount           String   @default("0")
  lastSyncedAt         DateTime?
  lastSyncAttemptAt    DateTime?
  lastSyncError        String   @default("")
  lastSyncStatus       String   @default("never")
  snapshots            YouTubeChannelSnapshot[]
  videos               YouTubeVideo[]
}

/// Public uploaded video metadata synced from YouTube Data API v3.
model YouTubeVideo {
  id              String   @id @default(cuid())
  videoId         String   @unique
  channelId       String
  channel         YouTubeChannel @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  title           String   @default("")
  description     String   @default("")
  publishedAt     DateTime?
  thumbnailUrl    String   @default("")
  durationSeconds Int      @default(0)
  durationDisplay String   @default("")
  tags            String   @default("[]")
  categoryId      String   @default("")
  definition      String   @default("")
  caption         String   @default("")
  privacyStatus   String   @default("")
  embeddable      Boolean  @default(true)
  madeForKids     Boolean  @default(false)
  viewCount       String   @default("0")
  likeCount       String   @default("0")
  commentCount    String   @default("0")
  lastSyncedAt    DateTime?
  snapshots       YouTubeVideoSnapshot[]

  @@index([channelId, publishedAt])
}

/// Periodic public counter snapshot for channel trend deltas.
model YouTubeChannelSnapshot {
  id               String         @id @default(cuid())
  channelId        String
  channel          YouTubeChannel @relation(fields: [channelId], references: [channelId], onDelete: Cascade)
  recordedAt       DateTime       @default(now())
  viewCount        String         @default("0")
  subscriberCount  String         @default("0")
  videoCount       String         @default("0")

  @@index([channelId, recordedAt])
}

/// Periodic public counter snapshot for video trend deltas.
model YouTubeVideoSnapshot {
  id           String       @id @default(cuid())
  videoId      String
  video        YouTubeVideo @relation(fields: [videoId], references: [videoId], onDelete: Cascade)
  recordedAt   DateTime     @default(now())
  viewCount    String       @default("0")
  likeCount    String       @default("0")
  commentCount String       @default("0")

  @@index([videoId, recordedAt])
}
